# Copiar a .env y llenar. NUNCA commitear .env ni pegar la URL real del túnel
# en chat, issues ni en el writeup — mientras corre, cualquiera con esa URL
# tiene acceso al modelo sin autenticación.

GEMMA_BASE_URL=
GEMMA_API_KEY=x
GEMMA_MODEL=gemma4:e2b-it-qat

# Timeout por request a Gemma. Un espectrograma en la Orin Nano tarda ~6-12s,
# así que 12 se queda corto si la Jetson está ocupada.
GEMMA_TIMEOUT_S=30

# Gemma corre en un solo dispositivo y las requests se encolan. Más de 2 en
# paralelo solo hace que todas lleguen tarde.
GEMMA_MAX_CONCURRENTES=2

PORT=5000
